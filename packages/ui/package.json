{
	"name": "@prettyfull/ui",
	"version": "1.0.0",
	"private": true,
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./styles.css": "./dist/index.css",
		"./extends.css": "./src/styles.css",
		"./layouts": "./src/layouts/**/*.tsx",
		".": "./src/*.tsx"
	},
	"scripts": {
		"build": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
		"build:components": "tsc",
		"check-types": "tsc --noEmit",
		"dev": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
		"dev:components": "tsc --watch",
		"lint": "eslint src --max-warnings 0"
	},
	"peerDependencies": {
		"next": "^15.4.6 || ^16.0.0"
	},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource/bebas-neue": "^5.3.0",
		"@hookform/resolvers": "^5.9.1",
		"@prettyfull/store": "workspace:*",
		"@prettyfull/utils": "workspace:*",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-tabs": "^1.1.21",
		"@tailwindcss/postcss": "^4.3.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"embla-carousel-react": "^8.6.0",
		"lucide-react": "^0.544.0",
		"motion": "^12.43.0",
		"postcss": "^8.5.28",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.87.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.1.3",
		"@prettyfull/eslint-config": "workspace:*",
		"@prettyfull/tailwind-config": "workspace:*",
		"@prettyfull/typescript-config": "workspace:*",
		"@storybook/addon-a11y": "^9.1.20",
		"@storybook/addon-docs": "^9.1.20",
		"@storybook/addon-vitest": "^9.1.20",
		"@storybook/react-vite": "^9.1.20",
		"@tailwindcss/cli": "^4.3.3",
		"@types/node": "^22.20.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitest/browser": "^3.2.7",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"eslint-plugin-storybook": "^9.1.20",
		"playwright": "^1.62.1",
		"storybook": "^9.1.20",
		"typescript": "5.9.3",
		"vitest": "^3.2.7"
	}
}
