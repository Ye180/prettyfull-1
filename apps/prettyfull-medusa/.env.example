# Database
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa

# Redis
REDIS_URL=redis://localhost:6379

# Secrets (generate secure random strings for production)
JWT_SECRET=supersecret-change-in-production
COOKIE_SECRET=supersecret-change-in-production

# Backend URL
MEDUSA_BACKEND_URL=https://admin.prettyfull.shop

# CORS
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3000

# Environment
NODE_ENV=production
PORT=9000

# Admin (enabled in production)
DISABLE_MEDUSA_ADMIN=false

# Worker mode (single-process for now)
MEDUSA_WORKER_MODE=server
