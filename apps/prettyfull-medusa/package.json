{
	"name": "prettyfull-medusa",
	"version": "0.0.1",
	"description": "A starter for Medusa projects.",
	"author": "Medusa (https://medusajs.com)",
	"license": "MIT",
	"keywords": [
		"sqlite",
		"postgres",
		"typescript",
		"ecommerce",
		"headless",
		"medusa"
	],
	"scripts": {
		"build": "medusa build",
		"seed": "medusa exec ./src/scripts/seed.ts",
		"seed:categories": "medusa exec ./src/scripts/seed-categories-only.ts",
		"start": "medusa start",
		"dev": "medusa develop",
		"predeploy": "medusa db:migrate",
		"migrate": "npx medusa db:migrate",
		"test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
		"test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
		"test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
	},
	"dependencies": {
		"@medusajs/admin-sdk": "2.11.3",
		"@medusajs/admin-shared": "2.11.3",
		"@medusajs/cli": "2.11.3",
		"@medusajs/dashboard": "2.11.3",
		"@medusajs/draft-order": "2.11.3",
		"@medusajs/file-s3": "2.11.3",
		"@medusajs/framework": "2.11.3",
		"@medusajs/icons": "2.11.3",
		"@medusajs/js-sdk": "2.11.3",
		"@medusajs/medusa": "2.11.3",
		"@medusajs/payment-stripe": "2.11.3",
		"@medusajs/types": "2.11.3",
		"@medusajs/ui": "4.0.27",
		"@tanstack/react-query": "^5.101.0",
		"react-router-dom": "^7.17.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@medusajs/test-utils": "2.11.3",
		"@swc/core": "^1.15.41",
		"@swc/jest": "^0.2.39",
		"@types/jest": "^29.5.14",
		"@types/node": "^20.19.43",
		"@types/react": "19.1.0",
		"@types/react-dom": "19.1.1",
		"jest": "^29.7.0",
		"prop-types": "^15.8.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"vite": "^5.4.21",
		"yalc": "1.0.0-pre.53"
	},
	"engines": {
		"node": ">=20"
	}
}
