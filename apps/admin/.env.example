# URL publique de l'API Hono.
NEXT_PUBLIC_API_URL=http://localhost:7777

# URL du storefront : sert à résoudre les visuels du catalogue, stockés
# en chemins relatifs à `apps/web/public`.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Adresse publique du bucket R2 (même valeur que R2_PUBLIC_URL côté API),
# sans barre finale. Lue à la compilation par next/image.
NEXT_PUBLIC_MEDIA_URL=
