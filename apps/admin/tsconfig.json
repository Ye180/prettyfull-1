{
	"extends": "@prettyfull/typescript-config/nextjs.json",
	"compilerOptions": {
		"declaration": false,
		"declarationMap": false,
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./src/*"],
			"@prettyfull/ui": ["../../packages/ui/src"],
			"@prettyfull/tailwind-config": [
				"../../packages/tailwind-config/shared.styles.css"
			]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"../../packages/ui/src/*"
	],
	"exclude": ["node_modules"]
}
