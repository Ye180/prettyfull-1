{
  "extends": "@prettyfull/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@prettyfull/ui": ["../../packages/ui/src"],
      "@prettyfull/tailwind-config": [
        "../../packages/tailwind-config/shared.styles.css"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/ui/src/*",
    "../../packages/ui/src/layouts"
  ],
  "exclude": ["node_modules"]
}
