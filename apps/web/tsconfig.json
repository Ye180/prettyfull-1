{
  "extends": "@prettyfull/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@prettyfull/ui": ["../../packages/ui/src/index.ts"],
      "@prettyfull/tailwind-config": [
        "../../packages/tailwind-config/shared.styles.css"
      ]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
