### Test des routes progressives SiteContent

@baseUrl = http://localhost:7777
@contentType = application/json

### ============================================
### STEP 1: Créer le document de base
### ============================================
# @name createStep1
POST {{baseUrl}}/site-content/step-1
Content-Type: {{contentType}}

{
  "key": "homepage-test-2025",
  "type": "SECTION",
  "isActive": true,
  "sortOrder": 1,
  "quote": {
    "fr": "Découvrez notre nouvelle collection",
    "en": "Discover our new collection"
  },
  "first": {
    "title": {
      "fr": "Bienvenue",
      "en": "Welcome"
    },
    "description": {
      "fr": "Notre collection printemps-été 2025",
      "en": "Our Spring-Summer 2025 collection"
    },
    "imageUrlDesktop": "https://example.com/hero-desktop.jpg",
    "imageUrlMobile": "https://example.com/hero-mobile.jpg",
    "ctaText": {
      "fr": "Découvrir",
      "en": "Discover"
    },
    "category": "507f1f77bcf86cd799439011"
  },
  "secondSection": {
    "title": {
      "fr": "Nos catégories",
      "en": "Our categories"
    },
    "category": ["507f1f77bcf86cd799439012", "507f1f77bcf86cd799439013"],
    "ctaText": {
      "fr": "Voir tout",
      "en": "See all"
    },
    "parentCategory": "507f1f77bcf86cd799439011"
  },
  "thirdSection": {
    "imageUrlDesktop": "https://example.com/banner-desktop.jpg",
    "imageUrlMobile": "https://example.com/banner-mobile.jpg",
    "category": "507f1f77bcf86cd799439014"
  }
}

### ============================================
### STEP 2: Ajouter sections 4, 5 et 6
### ============================================
### ⚠️ Remplacer {id} par l'ID retourné à l'étape 1
# @name updateStep2
PATCH {{baseUrl}}/site-content/{id}/step-2
Content-Type: {{contentType}}

{
  "fourthSection": {
    "title": {
      "fr": "Produits phares",
      "en": "Featured products"
    },
    "description": {
      "fr": "Nos meilleures ventes",
      "en": "Our best sellers"
    },
    "imageUrl": "https://example.com/featured.jpg",
    "category": "507f1f77bcf86cd799439015",
    "products": [
      {
        "id": 1,
        "name": "Produit 1",
        "price": 99.99,
        "imageUrl": "https://example.com/product1.jpg"
      },
      {
        "id": 2,
        "name": "Produit 2",
        "price": 149.99,
        "imageUrl": "https://example.com/product2.jpg"
      }
    ]
  },
  "fiveSection": {
    "title": {
      "fr": "Explorer par style",
      "en": "Browse by style"
    },
    "category": "507f1f77bcf86cd799439016",
    "ctaText": {
      "fr": "Tout voir",
      "en": "See all"
    },
    "subCategory": ["507f1f77bcf86cd799439017", "507f1f77bcf86cd799439018"]
  },
  "sixSection": {
    "imageUrlDesktop": "https://example.com/mid-banner-desktop.jpg",
    "imageUrlMobile": "https://example.com/mid-banner-mobile.jpg",
    "category": "507f1f77bcf86cd799439019"
  }
}

### ============================================
### STEP 3: Finaliser avec sections 7, 8, 9 et 10
### ============================================
### ⚠️ Remplacer {id} par l'ID retourné à l'étape 1
