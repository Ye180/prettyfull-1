{
	"name": "prettyfull",
	"private": true,
	"pnpm": {
		"overrides": {
			"@types/react": "19.1.0",
			"@types/react-dom": "19.1.1",
			"csstype": "3.1.3",
			"@medusajs/types": "2.11.3",
			"@medusajs/js-sdk": "2.11.3",
			"@medusajs/framework": "2.11.3"
		}
	},
	"resolutions": {
		"@types/react": "19.1.0",
		"@types/react-dom": "19.1.1",
		"csstype": "3.1.3"
	},
	"scripts": {
		"build": "turbo run build",
		"install:fonts": "pnpm install @fontsource-variable/manrope @fontsource/bebas-neue --filter @prettyfull/ui  --filter docs --filter web --filter ui  --filter tailwind-config",
		"dev": "turbo run dev ",
		"start:prod": "turbo run start ",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"prettier": "^3.6.2",
		"turbo": "^2.6.1",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@10.21.0",
	"engines": {
		"node": ">=20.9"
	}
}
